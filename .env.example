NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Base URL for canonical/hreflang tags. Must equal NUXT_PUBLIC_SITE_URL (read at runtime).
NUXT_PUBLIC_I18N_BASE_URL=http://localhost:3000

# Set to "false" on non-production environments to block crawling (robots Disallow + noindex meta).
# Production must be "true" so Google can crawl and index the site.
NUXT_PUBLIC_ALLOW_INDEXING=true
